rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Top-level User Document
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Disallow listing all users for privacy & HIPAA/GDPR isolation
      allow create, update: if isOwner(userId) && isValidId(userId);
      allow delete: if isOwner(userId);

      // Subcollection: Medical Reports
      match /medicalReports/{reportId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(reportId);
        allow delete: if isOwner(userId);
      }

      // Subcollection: Medical Equipment Scans
      match /equipmentScans/{scanId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(scanId);
        allow delete: if isOwner(userId);
      }

      // Subcollection: Prescription Medications
      match /medications/{medicationId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(medicationId);
        allow delete: if isOwner(userId);
      }

      // Subcollection: Medical Conditions
      match /medicalConditions/{conditionId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(conditionId);
        allow delete: if isOwner(userId);
      }

      // Subcollection: Allergies
      match /allergies/{allergyId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(allergyId);
        allow delete: if isOwner(userId);
      }

      // Subcollection: Appointments
      match /appointments/{appointmentId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(appointmentId);
        allow delete: if isOwner(userId);
      }

      // Subcollection: Health Timeline
      match /healthTimeline/{timelineId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(timelineId);
        allow delete: if isOwner(userId);
      }

      // Subcollection: AI Conversations
      match /aiConversations/{conversationId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(conversationId);
        allow delete: if isOwner(userId);
      }
    }
  }
}
